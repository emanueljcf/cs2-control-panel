# Copiar para .env.development ou .env.production e preencher

# Caminho raiz da instalação do servidor CS2 a controlar
CS2_ROOT=C:\cs2server-test

# Porta do jogo (UDP/TCP) nesta instalação
CS2_GAME_PORT=27020

# Porta onde o painel web fica disponível
PANEL_PORT=3000

# Segredo para assinar os cookies de sessão (gerar uma string aleatória longa)
SESSION_SECRET=troca-isto-por-uma-string-aleatoria-longa

# Ambiente: development | production
NODE_ENV=development
